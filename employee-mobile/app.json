{
  "expo": {
    "name": "StaffTrack",
    "slug": "employee-management-system",
    "version": "1.1.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#112250"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ishwarimahagaonkar.employeemanagementsystem"
    },
    "android": {
      "package": "com.ishwarimahagaonkar.employeemanagementsystem",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#112250"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "StaffTrack uses the camera to take a selfie when you punch in or out, confirming attendance.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-location",
        {
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "StaffTrack records your location during business trips to calculate accurate travel distance.",
          "locationAlwaysPermission": "StaffTrack records your location during business trips to calculate accurate travel distance.",
          "locationWhenInUsePermission": "StaffTrack uses your location to verify attendance and track business trips."
        }
      ],
      "expo-build-properties",
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics"
    ],
    "extra": {
      "eas": {
        "projectId": "f8e38dce-bf74-4651-981d-49bc63043588"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f8e38dce-bf74-4651-981d-49bc63043588"
    }
  }
}
