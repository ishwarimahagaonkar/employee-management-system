{
  "expo": {
    "name": "StaffTrack",
    "slug": "employee-management-system",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#112250"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.ishwarimahagaonkar.employeemanagementsystem",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#112250"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "f8e38dce-bf74-4651-981d-49bc63043588"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f8e38dce-bf74-4651-981d-49bc63043588"
    }
  }
}
